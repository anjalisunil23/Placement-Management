APP_NAME="Placement Management System"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://placements.amaljyothi.ac.in

# MariaDB (cPanel — MySQL Databases)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=placementsajce_db
DB_USERNAME=placementsajce_root
DB_PASSWORD=your_db_password

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRY=86400
SESSION_LIFETIME=7200

MAIL_DRIVER=elasticemail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=info@aessas.org
MAIL_FROM_NAME="Placement Cell - Amal Jyothi"
ELASTICEMAIL_API_KEY=
ELASTICEMAIL_ENDPOINT=https://api.elasticemail.com/v2/email/send

# WhatsApp (AES WAPI) — placement update templates
WHATSAPP_ENABLED=true
WHATSAPP_ENDPOINT=https://wapi.aesajce.in/send
WHATSAPP_TAG="AJCE Placements"
WHATSAPP_TEMPLATE=ajce_official_notification
WHATSAPP_SIGNATURE="AJCE Placement Cell"

MAX_RESUME_SIZE=5242880
MAX_JD_SIZE=10485760

# AWS S3 via campus Lambda (presigned URLs)
# Physical layout: ajce-placements/{folder}/{file}
AWS_S3_API_ENDPOINT=https://hep6ztvxpjewibbu6z57hmfijm0czbnu.lambda-url.ap-south-1.on.aws
AWS_S3_BUCKET=ajce-placements
AWS_S3_PHYSICAL_BUCKET=ajce-placements
AWS_S3_DOCS_ROOT=
AWS_S3_PREFIX=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_TIMEOUT=60

CORS_ALLOWED_ORIGINS=https://placements.amaljyothi.ac.in

# Coding Run Code — Wandbox only (LeetCode-style; no g++/JDK on shared hosting)
# cPanel: enable PHP extension "curl"; allow outbound HTTPS to wandbox.org (no CODING_PISTON_URL).
CODING_EXECUTOR=remote_only
CODING_REMOTE_BACKENDS=wandbox
CODING_WANDBOX_ENABLED=true
CODING_PISTON_FALLBACK=false
# Many shared hosts need this for outbound HTTPS to wandbox.org
CODING_HTTP_SSL_VERIFY=false
# If CODING_EXECUTOR is omitted on production (APP_ENV=production), the API defaults to Wandbox-only.
# Set true temporarily to log source/stdin/raw exit/stdout/stderr to PHP error_log
CODING_EXEC_DEBUG=false
# Do NOT set CODING_PISTON_URL=https://emkc.org/... (public API returns 401). Self-hosted Piston only if you add it later.

# Super-admin AES / portal logins (comma-separated)
SUPER_ADMIN_EMAILS=placements@amaljyothi.ac.in

# Staff Placements grid load (keep off when student_placements SQL table is authoritative — much faster)
STAFF_PLACEMENT_REGISTRY_MERGE_AES=0
STAFF_PLACEMENT_REGISTRY_MERGE_LOCAL=0
STAFF_PLACEMENT_REGISTRY_LIVE_AES=0
# Sync/backfill: live getStudInfo4Placement during Sync from AES (1 = on)
STAFF_PLACEMENT_ENRICH_AES_PROFILE=1
# Optional slow path on every grid refresh (0 = off; use Sync from AES instead)
STAFF_PLACEMENT_ENRICH_AES_PROFILE_ON_LIST=0
STAFF_PLACEMENT_ENRICH_AES_PROFILE_MAX=50
