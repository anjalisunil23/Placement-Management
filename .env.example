APP_NAME="Placement Management System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8080

# MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pms_db
DB_USERNAME=root
DB_PASSWORD=

# JWT
JWT_SECRET=change-this-to-a-long-random-secret-key
JWT_EXPIRY=86400

# Session
SESSION_LIFETIME=7200

# Email — ElasticEmail (primary) or SMTP
# Set ELASTICEMAIL_API_KEY from Elastic Email → Settings → Manage API Keys
# MAIL_FROM must be a verified sender/domain in Elastic Email
MAIL_DRIVER=elasticemail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=info@aessas.org
MAIL_FROM_NAME="Placement Cell - Amal Jyothi"
MAIL_TIMEOUT=20
MAIL_VERIFY_SSL=true
ELASTICEMAIL_API_KEY=
ELASTICEMAIL_ENDPOINT=https://api.elasticemail.com/v2/email/send
# Optional REST v4 endpoint (auto-tried if v2 fails):
# ELASTICEMAIL_ENDPOINT=https://api.elasticemail.com/v4/emails/transactional

# WhatsApp (AES WAPI) — placement update templates
WHATSAPP_ENABLED=true
WHATSAPP_ENDPOINT=https://wapi.aesajce.in/send
WHATSAPP_TAG="AJCE Placements"
WHATSAPP_TEMPLATE=ajce_official_notification
WHATSAPP_SIGNATURE="AJCE Placement Cell"

# Upload limits (bytes)
MAX_RESUME_SIZE=5242880
MAX_JD_SIZE=10485760

# AWS S3 via campus Lambda (presigned URLs)
# Physical layout: ajce-placements/{folder}/{file}
AWS_S3_API_ENDPOINT=https://hep6ztvxpjewibbu6z57hmfijm0czbnu.lambda-url.ap-south-1.on.aws
AWS_S3_BUCKET=ajce-placements
AWS_S3_PHYSICAL_BUCKET=ajce-placements
AWS_S3_DOCS_ROOT=
AWS_S3_PREFIX=
AWS_S3_PUBLIC_BASE_URL=
AWS_S3_TIMEOUT=60

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Super-admin AES / portal logins (comma-separated)
SUPER_ADMIN_EMAILS=placements@amaljyothi.ac.in

# OpenAI (AI aptitude question generation — PHP backend only, never exposed to browser)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT=120

# Coding — self-hosted Piston (see docs/CODE_EXECUTION.md and docker-compose.coding-exec.yml)
CODE_EXECUTION_URL=http://127.0.0.1:2000
CODING_EXEC_MODE=remote_only
CODING_REMOTE_BACKENDS=piston
CODING_REMOTE_FALLBACK=true
# Optional local worker sandbox before remote (worker_then_remote):
# CODING_EXEC_MODE=worker_then_remote
# CODING_SANDBOX_ROOT=/var/lib/pms-coding-sandbox
# CODING_RUN_USER=coding_runner
# Optional absolute paths when PHP PATH is empty (cPanel):
# CODING_GXX_PATH=/usr/bin/g++
# CODING_GCC_PATH=/usr/bin/gcc
# CODING_PYTHON_PATH=/usr/bin/python3
# CODING_NODE_PATH=/usr/bin/node
# CODING_JAVAC_PATH=/usr/bin/javac
# CODING_JAVA_PATH=/usr/bin/java
# CODING_EXEC_PATHS=/usr/bin,/usr/local/bin

# Tutorials practice runner. This is separate from Coding.
# Set it to an isolated Piston-compatible service (POST /execute or /api/v2/execute).
# Do not point it at this PHP application. Leave it empty to keep Run/Submit disabled.
# TUTORIAL_PISTON_URL=http://127.0.0.1:2000
# TUTORIAL_PISTON_TIMEOUT=25

# AES institute API (api.aesajce.in)
AES_AUTH_KEY=
AES_REF_HOST=placements.amaljyothi.ac.in
AES_API_URL=https://api.aesajce.in/
AES_API_ORIGIN=https://www.aesajce.in
AES_API_REFERER=https://www.aesajce.in/
# AES JSON API (course search, placement filters) — default 45s; raise if you see 15s cURL timeouts
AES_API_TIMEOUT=45
AES_API_CONNECT_TIMEOUT=12
# Students page getAllStudInfo4Placement (shared hosting often defaults to 128M)
AES_DIRECTORY_MEMORY_LIMIT=512M
